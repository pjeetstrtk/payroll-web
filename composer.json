{
    "name": "breb/payroll-web",
    "type": "project",
    "description": "BREB Payroll Management System - Laravel 12 / MySQL 8.0.33 port of the ASP.NET WebForms + Oracle application",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
